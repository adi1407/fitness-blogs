NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=dev-fitknowledge-jwt-change-me

# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgresql://fitness:fitness_secret@localhost:5432/fitness
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness_secret
POSTGRES_DB=fitness
POSTGRES_PORT=5432

# Absolute origin for uploaded images (leave empty to use request host, e.g. http://localhost:4000)
# PUBLIC_ASSET_BASE_URL=http://localhost:4000

# Public site (for Google OAuth return redirects)
PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth — public member sign-in
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URI (must match exactly):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/public/auth/google/callback
# OAuth consent screen (External) — Privacy policy + Terms of service URLs:
# Local: http://localhost:3000/privacy  and  http://localhost:3000/terms
# Production: https://YOUR-FRONTEND.vercel.app/privacy  and  .../terms

# Production (Render)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# PUBLIC_ASSET_BASE_URL=https://your-api.onrender.com
# PUBLIC_SITE_URL=https://your-frontend.vercel.app
# GOOGLE_REDIRECT_URI=https://your-api.onrender.com/api/v1/public/auth/google/callback
