# Public site (Vercel)
# Prefer API_URL (runtime, server) — works after env change even without relying on build cache
API_URL=https://fitness-blogs-xkec.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://fitness-blogs-xkec.onrender.com/api/v1
NEXT_PUBLIC_SITE_URL=https://fitness-blogs-liard.vercel.app

# OpenPanel Cloud (Production) — see docs/ANALYTICS_OPENPANEL.md
# Get Client ID: https://dashboard.openpanel.dev → Settings → Clients
NEXT_PUBLIC_OPENPANEL_API_URL=https://api.openpanel.dev
NEXT_PUBLIC_OPENPANEL_DASHBOARD_URL=https://dashboard.openpanel.dev
# NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Self-host override (local OpenPanel only):
# NEXT_PUBLIC_OPENPANEL_API_URL=http://localhost:3333
# NEXT_PUBLIC_OPENPANEL_DASHBOARD_URL=http://localhost:3000
